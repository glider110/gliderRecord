source "https://rubygems.org"

gem "jekyll", "~> 3.9"
# 处理无 front matter 的 Markdown 页面
gem "jekyll-optional-front-matter"
# 从标题提取页面标题
gem "jekyll-titles-from-headings"
# Markdown & GFM 支持
gem "kramdown", "~> 2.4"
gem "kramdown-parser-gfm"
# Ruby 3 运行 Jekyll 本地服务需要（尽管 CI 构建通常不需要，但加上更稳妥）
gem "webrick", "~> 1.7"
